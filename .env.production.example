# Names only. Copy to /var/www/supremesteroid/shared/.env and fill values on the server.
# Do not commit the filled file. Generate APP_KEY once and reuse it.
# Changing APP_KEY invalidates encrypted cookies, sessions, and encrypted columns.

APP_NAME="Supreme Steroids"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://supremesteroid.uk
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DATABASE_URL=
DATABASE_URL_UNPOOLED=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=supremesteroid.uk
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=supreme_steroids_cache

QUEUE_CONNECTION=sync

MAIL_MAILER=resend
RESEND_API_KEY=
# Optional SMTP fallback if MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@supremesteroid.uk
MAIL_FROM_NAME="Supreme Steroids"
STORE_SUPPORT_EMAIL=info@supremesteroid.uk
ADMIN_DEFAULT_EMAIL=info@supremesteroid.uk

OBJECT_STORAGE_DISK=s3
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
UPLOAD_MAX_KILOBYTES=10240
OBJECT_STORAGE_SIGNED_URL_MINUTES=30

BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BIC=
BANK_NAME=
BANK_REFERENCE_HINT=

CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_USDT_ERC20_ADDRESS=
CRYPTO_REFERENCE_HINT=

CRON_SECRET=
HSTS_ENABLED=false

# No analytics provider is configured.
# ANALYTICS_PROVIDER=
