# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://supremesteroid.uk"

# ==============================================================================
# SUPREME STEROIDS - PRODUCTION ENVIRONMENT CONFIGURATION
# Designed for Vercel Container/Serverless + Neon PostgreSQL + S3 Object Storage
# ==============================================================================

# Application Base
APP_NAME="Supreme Steroids"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en

# Logging (stderr/stdout for serverless containers)
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (Neon PostgreSQL in Production)
# Prefer the pooled DATABASE_URL for request-driven Vercel workloads.
# Example: postgres://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=ep-xxxx-xxxx.eu-west-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_NEON_PASSWORD_HERE
# Production runtime uses the pooled Neon URL. Migrations must use the direct
# connection because PgBouncer transaction pooling breaks locks and DDL.
DATABASE_URL="postgres://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-xxxx-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://neondb_owner:YOUR_NEON_PASSWORD_HERE@ep-xxxx-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"
DB_SSLMODE=require
# APP_KEY must be generated once and reused on every deployment.
# Changing APP_KEY invalidates encrypted sessions, cookies, and encrypted columns.

# Cache & Session (Stateless / Vercel Serverless Compatible)
# In production, use database driver backed by Neon PostgreSQL or Redis/Upstash
CACHE_STORE=database
CACHE_PREFIX=supreme_steroids_cache

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Queue Driver (Vercel Serverless: sync or external SQS/Redis)
QUEUE_CONNECTION=sync

# Object storage (S3 / Cloudflare R2). Do not use local disk in production.
FILESYSTEM_DISK=s3
OBJECT_STORAGE_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_OR_CLOUDFLARE_R2_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_OR_CLOUDFLARE_R2_SECRET
AWS_DEFAULT_REGION=auto
AWS_BUCKET=supreme-steroids-assets
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=https://assets.supremesteroid.uk
AWS_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
UPLOAD_MAX_KILOBYTES=10240
OBJECT_STORAGE_SIGNED_URL_MINUTES=30

# Vercel Cron authorization (Authorization: Bearer CRON_SECRET)
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Customer-visible payment instructions (never commit live values)
BANK_ACCOUNT_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
BANK_BIC=
BANK_NAME=
BANK_REFERENCE_HINT="Use your order number as the payment reference."
CRYPTO_BTC_ADDRESS=
CRYPTO_ETH_ADDRESS=
CRYPTO_USDT_TRC20_ADDRESS=
CRYPTO_USDT_ERC20_ADDRESS=

# Store Branding & Identity Config Points
STORE_LEGAL_NAME="Supreme Steroids"
STORE_DISPLAY_NAME="Supreme Steroids"
STORE_SUPPORT_EMAIL="info@supremesteroid.uk"
STORE_BUSINESS_ADDRESS="8 King Street, Hammersmith, London W6 9HW, United Kingdom"
STORE_APPROVED_LOGO_URL="https://assets.supremesteroid.uk/branding/logo.png"

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@supremesteroid.uk"
MAIL_FROM_NAME="Supreme Steroids"

# Filament Admin Configuration
ADMIN_PANEL_PATH=admin
ADMIN_DEFAULT_EMAIL="admin@supremesteroid.uk"
ADMIN_MFA_REQUIRED=true

# Security & Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY_MINUTES=1
RATE_LIMIT_CHECKOUT_MAX_ATTEMPTS=10
RATE_LIMIT_CHECKOUT_DECAY_MINUTES=5

